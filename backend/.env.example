# Puerto donde se ejecutará el servidor Express
PORT=3000

# URL de conexión a la base de datos PostgreSQL requerida por Prisma
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://usuario:contraseña@localhost:5432/muebles_crm?schema=public"

# Clave secreta para la firma y encriptación de tokens JWT
JWT_SECRET="escribe_aqui_una_cadena_secreta_y_segura"

# Entorno de ejecución (development, test, production)
NODE_ENV="development"

# URL del frontend para habilitar las peticiones CORS
CORS_ORIGIN="http://localhost:5173"